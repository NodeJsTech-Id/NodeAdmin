<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">News Management</h1>
    <div class="d-none d-sm-inline-block">
    </div>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">News List</h6>
                <div class="btn-group btn-sm nospiner" >
                    <a  href="/admin/v1/news/create"  class="btn btn-success btn-sm" >
                        <i class="fas fa-fw fa-plus"></i> Add Data
                    </a>
                    <button type="submit" form="selection" formmethod="post" formaction="/admin/v1/news/delete_selected" onclick="return confirm('Confirm Delete')" class="btn btn-danger btn-sm">
                        <i class="fas fa-fw fa-times"></i> Delete Selected
                    </button>
                </div>                                      
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">          
            <table class="table table-bordered table-hover">
                    <thead>
                        <form id="searchform">
                            <tr>
                                <th width="2%"></th>
                                <th width="7%">
                                    <select name="q_page_size" id="q_page_size"  class="form-control form-control-user" value="" autocomplete="q_page_size">
                                        <option value="10" <%= ((!filter.q_page_size) ? 'selected' : (filter.q_page_size == 10)) ? 'selected' : '' %>>10</option>
                                        <option value="20" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 20)) ? 'selected' : '' %>>20</option>
                                        <option value="50" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 50)) ? 'selected' : '' %>>50</option>
                                        <option value="100" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 100)) ? 'selected' : '' %>>100</option>
                                    </select>
                                </th>
                                <th>
									<select name="q_category_id" id="q_category_id" class="form-control form-control-user <% if(getError('q_category_id')) { %> is-invalid <% } %>" autocomplete="q_category_id">
                                        <option disabled="disabled" selected="selected">Select an option</option>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>" <%= (category.id == filter.q_category_id) ? 'selected' : '' %>><%= category.name %></option>
                                        <% }) %>
                                    </select>
								</th>
                                <th width="20%">
                                    <input id="q_title" type="text" class="form-control form-control-user" name="q_title" value="<%= filter.q_title %>" autocomplete="q_title">
                                </th>
                                <th width="10%">
                                    <select name="q_status" id="q_status"  class="form-control form-control-user" value="" autocomplete="q_status">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="Publish" <%= ((!filter.q_status) ? '' : (filter.q_status == 'Publish')) ? 'selected' : '' %>>Publish</option>
                                        <option value="Draft" <%= ((!filter.q_status) ? '' : (filter.q_status == 'Draft')) ? 'selected' : '' %>>Draft</option>
                                    </select>
                                </th>
                                <th width="10%">
                                    <select name="q_featured" id="q_featured"  class="form-control form-control-user" value="" autocomplete="q_featured">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="1" <%= ((!filter.q_featured) ? '' : (filter.q_featured == true)) ? 'selected' : '' %>>Yes</option>
                                        <option value="0" <%= ((!filter.q_featured) ? '' : (filter.q_featured == false)) ? 'selected' : '' %>>No</option>
                                    </select>
                                </th>
                                <th width="10%">
									<div class="row">
										<div class="col">
										    <input id="q_created_at_start" type="date" class="form-control form-control-user" name="q_created_at_start" value="<%= filter.q_created_at_start %>" autocomplete="q_created_at_start">
										</div>
										<div class="col">
										    <input id="q_created_at_end" type="date" class="form-control form-control-user" name="q_created_at_end" value="<%= filter.q_created_at_end %>" autocomplete="q_created_at_end">
										</div>
									</div>
								</th>
                                <th width="5%" class="text-center align-middle">
                                    <div class="btn-group nospiner" >
                                        <button type="submit" form="searchform" class="btn btn-sm btn-success">
                                            <i class="fas fa-fw fa-search"></i>
                                        </button>
                                        <a  href="/admin/v1/news"  class="btn btn-sm btn-danger">
                                            <i class="fas fa-fw fa-times"></i>                                            
                                        </a>
                                    </div>                                      
                                </th>
                            </tr>                              
                            <tr>
                                <th width="5%"><input type="checkbox" id="checkall"/></th>
                                <th width="5%">No</th>
                                <th width="20%">Category</th>
                                <th width="20%">Title</th>
                                <th width="10%">Status</th>
                                <th width="10%">Featured</th>
                                <th width="10%">Date</th>
                                <th width="5%">Action</th>
                            </tr>
                        </form>
                    </thead>
                    <tbody>
                        <form id="selection">
                            <% datas.forEach((data,i) => { %>
                            <tr>
                                <td><input name="selected[]" value="<%= data.id %>" type="checkbox" /></td>
                                <td><%= (i+1)+(paginate_data.page_size*(paginate_data.current_page-1)) %></td>
                                <td><%= data.category.name %></td>
                                <td><%= data.title %></td>
                                <td><%= data.status %></td>
                                <td><center><img src="<%= (data.featured) ? getFile('modules/access/true.png') : getFile('modules/access/false.png') %>" width="30px" height="30px"></center></td>
                                <td><%= formatDate(data.created_at,true) %></td>
                                <td align="center">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            Action
                                        </button>
                                        <div class="dropdown-menu">
                                            <a href="/admin/v1/news/<%= data.id %>/edit" class="dropdown-item">Edit</a>
                                            <a href="/admin/v1/news/<%= data.id %>/delete" onclick="return confirm('Confirm Delete')" class="dropdown-item">Delete</a>                                              
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </form>
                    </tbody>
                </table>
                <div class="d-flex justify-content-end">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">
                            <% if(paginate_data.current_page != 1) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page-1) %>">Previous</a></li>
                            <% } %>
                            <% for(let index = 1; index <= paginate_data.total_page; index++) { %>
                            <li class="page-item <%= (index==paginate_data.current_page)?'active':'' %>"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', index) %>"><%= index %></a></li>
                            <% } %>
                            <% if(paginate_data.current_page != paginate_data.total_page && paginate_data.total_page!=0) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page+1) %>">Next</a></li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>                
    </div>
</div>
<script>
    $("#checkall").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
    });        
</script>