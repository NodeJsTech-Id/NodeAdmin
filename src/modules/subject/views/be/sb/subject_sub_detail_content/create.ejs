<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Subject Sub Detail Content Management</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 align-items-center justify-content-between">
                <div class="text-start p-0 mb-4 font-weight-bold text-primary">
                    <div class="row m-0">
                        <div class="col-auto my-auto p-0">
                            Subject : <span style="font-weight: bolder;"><%= subject_sub_detail.subject_sub.subject.name %></span> <br>
                            Subject Sub : <span style="font-weight: bolder;"><%= subject_sub_detail.subject_sub.name %></span> <br>
                            Subject Sub Detail : <span style="font-weight: bolder;"><%= subject_sub_detail.name %></span>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row m-0 justify-content-between">
                    <h6 class="col text-start p-0 font-weight-bold text-primary">Subject Sub Detail Content Form</h6>
                </div> 
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <form method="POST" action="/admin/v1/subject_sub_detail_content/store?subject_sub_detail_id=<%= subject_sub_detail_id %>">
                    <input type="hidden" name="subject_sub_detail_id" value="<%= subject_sub_detail_id %>">
                    <div class="form-group row" id="div_name">
                        <label for="name" class="col-md-3 col-form-label text-md-right">Name</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <input id="name" type="text" class="form-control form-control-user <% if(getError('name')) { %> is-invalid <% } %>" name="name" value="<%= getOld('name') %>" autocomplete="name">
                            <% if(getError('name')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('name')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row" id="div_content">
                        <label for="content" class="col-md-3 col-form-label text-md-right">Content</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <textarea id="content" data-subject-id="<%= subject_sub_detail.subject_sub.subject.id %>" class="contentField form-control form-control-user <% if(getError('content')) { %> is-invalid <% } %>" name="content" autocomplete="content"></textarea>
                            <% if(getError('content')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('content')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-6 offset-md-12">
                            <button type="submit" class="btn btn-user btn-primary btn-block">
                                Save
                            </button>
                        </div>
                        <div class="col-md-6 offset-md-12">
                            <a href="/admin/v1/subject_sub_detail_content?subject_sub_detail_id=<%= subject_sub_detail_id %>" type="submit" class="btn btn-user btn-danger btn-block text-white">
                                Back
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>                
    </div>
</div>

<script>
    $(".select2").select2();
</script>

<div class="modal fade" id="fileManagerModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">File Manager</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="uploadForm" class="mb-3">
                    <div class="input-group mb-3">
                        <input type="file" name="file" class="form-control" placeholder="Select file..." aria-label="Select file..." aria-describedby="basic-addon2">
                        <div class="input-group-append">
                            <button class="btn btn-outline-primary" type="submit">Upload</button>
                        </div>
                    </div>
                </form>
                <hr>
                <div id="fileList" class="d-flex flex-wrap gap-3"></div>
            </div>
        </div>
    </div>
</div>
<script>
    function loadFileManager(subjectId) {
        fetch(`/admin/v1/subject/${subjectId}/file`, {
            credentials: 'include'
        })
        .then(res => res.json())
        .then(response => {
            const list = document.getElementById('fileList');
            list.innerHTML = '';
            if (response.data.datas.length == 0) {
                const div = document.createElement('div');
                div.className = 'p-2 m-auto';
                div.innerHTML = `<p>File kosong</p>`;
                list.appendChild(div);
            }
            response.data.datas.forEach(file => {
                const div = document.createElement('div');
                div.className = 'border p-2';
                div.innerHTML = `
                    <img src="${file.path}" alt="" style="max-height:150px;cursor:pointer;" onclick="insertToEditor('${file.path}')"><br>
                    <button class="btn btn-sm btn-danger mt-1" onclick="if(confirm('Anda yakin ingin menghapus file ini?')) deleteFile('${subjectId}', '${file.id}')">Hapus</button>
                `;
                list.appendChild(div);
            });
        });
    }

    function insertToEditor(url) {
        if (!window.trumbowygTarget) return;
        const editor = window.trumbowygTarget;
        // Pastikan dalam mode visual, bukan HTML
        if (editor.isCode) {
            editor.toggle(); // switch ke WYSIWYG
        }
        // Sisipkan gambar sebagai tag <img>
        const html = `<img src="${url}" alt="Gambar" style="max-width: 100%;">`;
        editor.execCmd('insertHTML', html);
        editor.syncCode();
        // Sembunyikan modal dan reset
        window.trumbowygTarget = null;
        window.modalFileManager.hide();
    }

    function deleteFile(subjectId, fileId) {
        fetch(`/admin/v1/subject/${subjectId}/file/${fileId}/delete`, {
            method: 'DELETE',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
        })
        .then(async res => {
            const isJson = res.headers.get('content-type')?.includes('application/json');
            if (!res.ok) {
                const errorData = isJson ? await res.json() : { message: res.statusText || 'Internal Server Error' };
                throw new Error(errorData.message);
            }
            const response = await res.json();
            if (!response.status) {
                throw new Error(response.message || 'Terjadi kesalahan');
            }
            loadFileManager(subjectId);
        })
        .catch(err => {
            console.error('Upload gagal:', err);
            alert(err.message);
        });
    }

    document.getElementById('uploadForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const subjectId = window.trumbowygTarget?.$c?.attr('data-subject-id');
        const formData = new FormData(this);
        fetch(`/admin/v1/subject/${subjectId}/file/store`, {
            method: 'POST',
            body: formData,
            credentials: 'include',
        })
        .then(async res => {
            const isJson = res.headers.get('content-type')?.includes('application/json');
            if (!res.ok) {
                const errorData = isJson ? await res.json() : { message: res.statusText || 'Internal Server Error' };
                throw new Error(errorData.message);
            }
            const response = await res.json();
            if (!response.status) {
                throw new Error(response.message || 'Terjadi kesalahan');
            }
            this.reset();
            setTimeout(() => {
                loadFileManager(subjectId);
            }, 1000);
        })
        .catch(err => {
            console.error('Upload gagal:', err);
            alert(err.message);
        });
    });
</script>
<script src="/be/sb/js/trumbowyg.filemanager.js"></script>
<script>
    $(".contentField").trumbowyg({
        btns: [
            ['viewHTML'],
            ['formatting'],
            ['strong', 'em', 'del'],
            ['superscript', 'subscript'],
            ['link'],
            ['filemanager'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
            ['removeformat'],
            ['fullscreen']
        ],
        lang: 'id',
        plugins: {
            filemanager: true
        }
    });
</script>