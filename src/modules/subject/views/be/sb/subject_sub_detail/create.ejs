<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Subject Sub Detail Management</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 align-items-center justify-content-between">
                <div class="text-start p-0 mb-4 font-weight-bold text-primary">
                    <div class="row m-0">
                        <div class="col-auto my-auto p-0">
                            Subject : <span style="font-weight: bolder;"><%= subject_sub.subject.name %></span> <br>
                            Subject Sub : <span style="font-weight: bolder;"><%= subject_sub.name %></span>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row m-0 justify-content-between">
                    <h6 class="col text-start p-0 font-weight-bold text-primary">Subject Sub Detail Form</h6>
                </div> 
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <form method="POST" action="/admin/v1/subject_sub_detail/store?subject_sub_id=<%= subject_sub_id %>">
                    <input type="hidden" name="subject_sub_id" value="<%= subject_sub_id %>">
                    <div class="form-group row" id="div_order">
                        <label for="order" class="col-md-3 col-form-label text-md-right">Order</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <input id="order" type="number" class="form-control form-control-user <% if(getError('order')) { %> is-invalid <% } %>" name="order_number" value="<%= getOld('order') %>" autocomplete="order">
                            <% if(getError('order')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('order')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row" id="div_name">
                        <label for="name" class="col-md-3 col-form-label text-md-right">Name</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <input id="name" type="text" class="form-control form-control-user <% if(getError('name')) { %> is-invalid <% } %>" name="name" value="<%= getOld('name') %>" autocomplete="name">
                            <% if(getError('name')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('name')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row" id="div_desc">
                        <label for="desc" class="col-md-3 col-form-label text-md-right">Description</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <input id="desc" type="text" class="form-control form-control-user <% if(getError('desc')) { %> is-invalid <% } %>" name="desc" value="<%= getOld('desc') %>" autocomplete="desc">
                            <% if(getError('desc')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('desc')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-6 offset-md-12">
                            <button type="submit" class="btn btn-user btn-primary btn-block">
                                Save
                            </button>
                        </div>
                        <div class="col-md-6 offset-md-12">
                            <a href="/admin/v1/subject_sub_detail?subject_sub_id=<%= subject_sub_id %>" type="submit" class="btn btn-user btn-danger btn-block text-white">
                                Back
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>                
    </div>
</div>

<script>
    $(".select2").select2();
</script>