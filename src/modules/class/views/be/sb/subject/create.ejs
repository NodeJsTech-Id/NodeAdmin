<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Class <bold><%= classData.name %></bold> Subject Management</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Class Subject Form</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <form method="POST" action="/admin/v1/class/<%= classData.id %>/subject/store">
                    <div class="form-group row">
                        <label for="subject_id" class="col-md-3 col-form-label text-md-right">Subject</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <select name="subject_id" id="subject_id" class="select2 form-control form-control-user <% if(getError('subject_id')) { %> is-invalid <% } %>" value="" autocomplete="subject_id">
                                <option disabled="disabled" selected="selected">Select an option</option>
                                <% subjects.forEach(subject => { %>
                                    <option value="<%= subject.id %>" <%= (subject.id == getOld('subject_id')) ? 'selected' : '' %>><%= subject.name %></option>
                                <% }) %>
                            </select>
                            <% if(getError('subject_id')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('subject_id')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-6 offset-md-12">
                            <button type="submit" class="btn btn-user btn-primary btn-block">
                                Save
                            </button>
                        </div>
                        <div class="col-md-6 offset-md-12">
                            <a href="/admin/v1/class/<%= classData.id %>/subject" type="submit" class="btn btn-user btn-danger btn-block text-white">
                                Back
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>                
    </div>
</div>
<script>
    $(".select2").select2();
</script>