<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Show Content</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 align-items-center justify-content-between">
                <div class="text-start p-0 mb-4 font-weight-bold text-primary">
                    <div class="row m-0">
                        <div class="col-auto my-auto p-0">
                            Subject : <span style="font-weight: bolder;"><%= data.subject_sub_detail.subject_sub.subject.name %></span> <br>
                            Subject Sub : <span style="font-weight: bolder;"><%= data.subject_sub_detail.subject_sub.name %></span> <br>
                            Subject Sub Detail : <span style="font-weight: bolder;"><%= data.subject_sub_detail.name %></span>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row m-0 justify-content-between">
                    <h6 class="col text-start p-0 font-weight-bold text-primary">Name <span style="font-weight: bolder;"><%= data.name %></span></h6>
                    <div class="col text-end p-0">
                        <div class="btn-group btn-sm nospiner" >
                            <a  href="/admin/v1/class/<%= class_id %>/subject"  class="btn btn-warning btn-sm" >
                                <i class="fas fa-fw fa-arrow-left"></i> Back
                            </a>
                        </div>                                      
                    </div>
                </div> 
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <div class="container">
                    <%- data.content %>
                </div>
            </div>
        </div>                
    </div>
</div>