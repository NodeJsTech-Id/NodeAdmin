<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Meeting Mentee Management</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Meeting Mentee Form</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <form method="POST" action="/admin/v1/meeting/<%= data.id %>/users/assign">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th width="5%"><input type="checkbox" id="checkall"/></th>
                                <th width="5%">No</th>
                                <th width="15%">Code</th>
                                <th width="20%">Name</th>
                                <th width="20%">Phone</th>
                                <th width="15%">Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            <form id="selection">
                                <% users.forEach((user,i) => { %>
                                <tr>
                                    <td><input name="users[]" value="<%= user.id %>" <% if(data.users.some(r => r.id === user.id)) { %>checked<% } %> type="checkbox" /></td>
                                    <td><%= i+1 %></td>
                                    <td><%= user.code %></td>
                                    <td><%= user.name %></td>
                                    <td><%= user.phone %></td>
                                    <td><%= user.email %></td>
                                </tr>
                                <% }); %>
                            </form>
                        </tbody>
                    </table>
                    <div class="form-group row">
                        <div class="col-md-6 offset-md-12">
                            <button type="submit" class="btn btn-user btn-primary btn-block">
                                Save
                            </button>
                        </div>
                        <div class="col-md-6 offset-md-12">
                            <a href="/admin/v1/meeting" type="submit" class="btn btn-user btn-danger btn-block text-white">
                                Back
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>                
    </div>
</div>
<script>
    $("#checkall").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
    });        
</script>