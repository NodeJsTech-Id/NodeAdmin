<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<style>
    .preview {
        margin-top: 20px;
    }
    .preview img {
        max-width: 100%;
        max-height: 300px;
    }
</style>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">User Management</h1>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">User Profile Form</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">
                <form method="POST" action="/admin/v1/userprofile/update?_method=PUT" enctype="multipart/form-data">
                    <div class="form-group row mb-3">
                        <label for="profession_id" class="col-md-3 col-form-label text-md-right">Profession</label>
                        <div class="col-md-8 mb-sm-0">
                            <select name="profession_id" id="profession_id" class="select2 form-control form-control-user <% if(getError('profession_id')) { %> is-invalid <% } %>" value="" autocomplete="profession_id">
                                <option disabled="disabled" selected="selected">Select an option</option>
                                <% professions.forEach(profession => { %>
                                    <option value="<%= profession.id %>" <%= (profession.id == data?.profession_id) ? 'selected' : '' %>><%= profession.name %></option>
                                <% }) %>
                            </select>
                            <% if(getError('profession_id')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('profession_id')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row" id="div_address">
                        <label for="address" class="col-md-3 col-form-label text-md-right">Address</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <textarea id="address" class="form-control form-control-user <% if(getError('address')) { %> is-invalid <% } %>" name="address" autocomplete="address"><%= data?.address %></textarea>
                            <% if(getError('address')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('address')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row" id="div_biography">
                        <label for="biography" class="col-md-3 col-form-label text-md-right">Biography</label>
                        <div class="col-md-8 mb-3 mb-sm-0">
                            <textarea id="biography" class="form-control form-control-user <% if(getError('biography')) { %> is-invalid <% } %>" name="biography" autocomplete="biography"><%= data?.biography %></textarea>
                            <% if(getError('biography')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('biography')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row mb-3" id="div_office_name">
                        <label for="office_name" class="col-md-3 col-form-label text-md-right">Office Name</label>
                        <div class="col-md-8 mb-sm-0">
                            <input id="office_name" type="text" class="form-control form-control-user <% if(getError('office_name')) { %> is-invalid <% } %>" name="office_name" value="<%= data?.office_name %>" autocomplete="office_name">
                            <% if(getError('office_name')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('office_name')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row mb-3" id="div_office_address">
                        <label for="office_address" class="col-md-3 col-form-label text-md-right">Office Address</label>
                        <div class="col-md-8 mb-sm-0">
                            <input id="office_address" type="text" class="form-control form-control-user <% if(getError('office_address')) { %> is-invalid <% } %>" name="office_address" value="<%= data?.office_address %>" autocomplete="office_address">
                            <% if(getError('office_address')) { %>
                                <span class="invalid-feedback" status="alert">
                                    <strong><%= getError('office_address')['msg'] %></strong>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-6 offset-md-12">
                            <button type="submit" class="btn btn-user btn-primary btn-block">
                                Save
                            </button>
                        </div>
                        <div class="col-md-6 offset-md-12">
                            <a href="/admin/v1/dashboard" type="submit" class="btn btn-user btn-danger btn-block text-white">
                                Back
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>                
    </div>
</div>
<script>
    $(".select2").select2();
</script>