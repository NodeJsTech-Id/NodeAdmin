<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Home Page Menu Management</h1>
    <div class="d-none d-sm-inline-block">
    </div>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Home Page Menu List</h6>
                <div class="btn-group btn-sm nospiner" >
                    <a  href="/admin/v1/homepage/menu/create"  class="btn btn-success btn-sm" >
                        <i class="fas fa-fw fa-plus"></i> Add Data
                    </a>
                    <button type="submit" form="selection" formmethod="post" formaction="/admin/v1/homepage/menu/delete_selected" onclick="return confirm('Confirm Delete')" class="btn btn-danger btn-sm">
                        <i class="fas fa-fw fa-times"></i> Delete Selected
                    </button>
                </div>                                      
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">          
                <table class="table table-bordered table-hover">
                    <thead>
                        <form id="searchform">
                            <tr>
                                <th width="2%"></th>
                                <th width="7%">
                                    <select name="q_page_size" id="q_page_size"  class="form-control form-control-user" value="" autocomplete="q_page_size">
                                        <option value="10" <%= ((!filter.q_page_size) ? 'selected' : (filter.q_page_size == 10)) ? 'selected' : '' %>>10</option>
                                        <option value="20" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 20)) ? 'selected' : '' %>>20</option>
                                        <option value="50" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 50)) ? 'selected' : '' %>>50</option>
                                        <option value="100" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 100)) ? 'selected' : '' %>>100</option>
                                    </select>
                                </th>
                                <th>
									<select name="q_position" id="q_position" class="form-control form-control-user <% if(getError('q_position')) { %> is-invalid <% } %>" autocomplete="q_position">
                                        <option disabled="disabled" selected="selected">Select an option</option>
                                        <option value="Main" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 'Main')) ? 'selected' : '' %>>Main</option>
                                        <option value="Footer" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 'Footer')) ? 'selected' : '' %>>Footer</option>
                                    </select>
								</th>
                                <th width="20%">
                                    <input id="q_name" type="text" class="form-control form-control-user" name="q_name" value="<%= filter.q_name %>" autocomplete="q_name">
                                </th>
                                <th width="15%">
                                    <input id="q_url" type="text" class="form-control form-control-user" name="q_url" value="<%= filter.q_url %>" autocomplete="q_url">
                                </th>
                                <th width="10%">
                                    <select name="q_target" id="q_target"  class="form-control form-control-user" value="" autocomplete="q_target">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="_parent" <%= ((!filter.q_target) ? '' : (filter.q_target == '_parent')) ? 'selected' : '' %>>Self Tab</option>
                                        <option value="_blank" <%= ((!filter.q_target) ? '' : (filter.q_target == '_blank')) ? 'selected' : '' %>>New Tab</option>
                                    </select>
                                </th>
                                <th width="10%">
                                    <select name="q_status" id="q_status"  class="form-control form-control-user" value="" autocomplete="q_status">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="Active" <%= ((!filter.q_status) ? '' : (filter.q_status == 'Active')) ? 'selected' : '' %>>Active</option>
                                        <option value="Inactive" <%= ((!filter.q_status) ? '' : (filter.q_status == 'Inactive')) ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </th>
                                <th width="5%" class="text-center align-middle">
                                    <div class="btn-group nospiner" >
                                        <button type="submit" form="searchform" class="btn btn-sm btn-success">
                                            <i class="fas fa-fw fa-search"></i>
                                        </button>
                                        <a  href="/admin/v1/homepage/menu"  class="btn btn-sm btn-danger">
                                            <i class="fas fa-fw fa-times"></i>                                            
                                        </a>
                                    </div>                                      
                                </th>
                            </tr>                              
                            <tr>
                                <th width="5%"><input type="checkbox" id="checkall"/></th>
                                <th width="5%">No</th>
                                <th width="20%">Position</th>
                                <th width="20%">Name</th>
                                <th width="20%">Url</th>
                                <th width="10%">Target</th>
                                <th width="10%">Status</th>
                                <th width="5%">Action</th>
                            </tr>
                        </form>
                    </thead>
                    <tbody>
                        <form id="selection">
                            <% datas.forEach((data,i) => { %>
                                <tr>
                                    <td><input name="selected[]" value="<%= data.id %>" type="checkbox" /></td>
                                    <td><%= (i+1)+(paginate_data.page_size*(paginate_data.current_page-1)) %></td>
                                    <td><%= data.position %></td>
                                    <td><%= data.name %></td>
                                    <td><%= data.url %></td>
                                    <td><%= data.target %></td>
                                    <td><%= data.status %></td>
                                    <td align="center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                Action
                                            </button>
                                            <div class="dropdown-menu">
                                                <a href="/admin/v1/homepage/menu/<%= data.id %>/edit" class="dropdown-item">Edit</a>
                                                <a href="/admin/v1/homepage/menu/<%= data.id %>/delete" onclick="return confirm('Confirm Delete')" class="dropdown-item">Delete</a>                                              
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% if(data.childs?.length > 0) { %>
                                    <tr>
                                        <td></td>
                                        <td colspan="7">
                                            <table class="table table-bordered table-hover">
                                                <thead>
                                                    <tr>
                                                        <th width="5%"></th>
                                                        <th width="5%">No</th>
                                                        <th width="20%">Position</th>
                                                        <th width="20%">Name</th>
                                                        <th width="20%">Url</th>
                                                        <th width="10%">Target</th>
                                                        <th width="10%">Status</th>
                                                        <th width="5%">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <form id="selection">
                                                        <% data.childs.forEach((child,j) => { %>
                                                            <tr>
                                                                <td><input name="selected[]" value="<%= child.id %>" type="checkbox" /></td>
                                                                <td><%= (j+1) %></td>
                                                                <td><%= child.position %></td>
                                                                <td><%= child.name %></td>
                                                                <td><%= child.url %></td>
                                                                <td><%= child.target %></td>
                                                                <td><%= child.status %></td>
                                                                <td align="center">
                                                                    <div class="btn-group">
                                                                        <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                                            Action
                                                                        </button>
                                                                        <div class="dropdown-menu">
                                                                            <a href="/admin/v1/homepage/menu/<%= child.id %>/edit" class="dropdown-item">Edit</a>
                                                                            <a href="/admin/v1/homepage/menu/<%= child.id %>/delete" onclick="return confirm('Confirm Delete')" class="dropdown-item">Delete</a>                                              
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% if(child.childs?.length > 0) { %>
                                                                <tr>
                                                                    <td></td>
                                                                    <td colspan="6">
                                                                        <table class="table table-bordered table-hover">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th width="5%"></th>
                                                                                    <th width="5%">No</th>
                                                                                    <th width="20%">Position</th>
                                                                                    <th width="20%">Name</th>
                                                                                    <th width="20%">Url</th>
                                                                                    <th width="10%">Target</th>
                                                                                    <th width="10%">Status</th>
                                                                                    <th width="5%">Action</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                <form id="selection">
                                                                                    <% child.childs.forEach((child2,k) => { %>
                                                                                        <tr>
                                                                                            <td><input name="selected[]" value="<%= child2.id %>" type="checkbox" /></td>
                                                                                            <td><%= (k+1) %></td>
                                                                                            <td><%= child2.position %></td>
                                                                                            <td><%= child2.name %></td>
                                                                                            <td><%= child2.url %></td>
                                                                                            <td><%= child2.target %></td>
                                                                                            <td><%= child2.status %></td>
                                                                                            <td align="center">
                                                                                                <div class="btn-group">
                                                                                                    <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                                                                        Action
                                                                                                    </button>
                                                                                                    <div class="dropdown-menu">
                                                                                                        <a href="/admin/v1/homepage/menu/<%= child2.id %>/edit" class="dropdown-item">Edit</a>
                                                                                                        <a href="/admin/v1/homepage/menu/<%= child2.id %>/delete" onclick="return confirm('Confirm Delete')" class="dropdown-item">Delete</a>                                              
                                                                                                    </div>
                                                                                                </div>
                                                                                            </td>
                                                                                        </tr>
                                                                                    <% }); %>
                                                                                </form>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            <% } %>
                                                        <% }); %>
                                                    </form>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }); %>
                        </form>
                    </tbody>
                </table>
                <div class="d-flex justify-content-center">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">
                            <% if(paginate_data.current_page != 1) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page-1) %>">Previous</a></li>
                            <% } %>
                            <% for(let index = 1; index <= paginate_data.total_page; index++) { %>
                            <li class="page-item <%= (index==paginate_data.current_page)?'active':'' %>"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', index) %>"><%= index %></a></li>
                            <% } %>
                            <% if(paginate_data.current_page != paginate_data.total_page && paginate_data.total_page!=0) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page+1) %>">Next</a></li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>                
    </div>
</div>
<script>
    $("#checkall").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
    });
</script>