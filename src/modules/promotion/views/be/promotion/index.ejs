<% if(getFlashMessage('error')) { %>
    <div class="card shadow bg-danger text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('error').message %></div>
    </div>
<% } %>
<% if(getFlashMessage('success')) { %>
    <div class="card shadow bg-success text-white" style="margin-bottom:20px;">
        <div class="card-body" style="overflow-x:auto;padding:10px;"><%= getFlashMessage('success').message %></div>
    </div>
<% } %>
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Promotion Management</h1>
    <div class="d-none d-sm-inline-block">
    </div>
</div>
<!-- Content Row -->
<div class="row">
    <!-- Area Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Promotion List</h6>
                <div class="btn-group btn-sm nospiner" >
                    <a  href="/admin/v1/promotion/create"  class="btn btn-success btn-sm" >
                        <i class="fas fa-fw fa-plus"></i> Add Data
                    </a>
                    <button type="submit" form="selection" formmethod="post" formaction="/admin/v1/promotion/delete_selected" onclick="return confirm('Confirm Delete')" class="btn btn-danger btn-sm">
                        <i class="fas fa-fw fa-times"></i> Delete Selected
                    </button>
                </div>                                      
            </div>
            <!-- Card Body -->
            <div class="card-body" style="overflow-x:auto;padding:20px;">          
            <table class="table table-bordered table-hover">
                    <thead>
                        <form id="searchform">
                            <tr>
                                <th width="2%"></th>
                                <th width="7%">
                                    <select name="q_page_size" id="q_page_size"  class="form-control form-control-user" value="" autocomplete="q_page_size">
                                        <option value="10" <%= ((!filter.q_page_size) ? 'selected' : (filter.q_page_size == 10)) ? 'selected' : '' %>>10</option>
                                        <option value="20" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 20)) ? 'selected' : '' %>>20</option>
                                        <option value="50" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 50)) ? 'selected' : '' %>>50</option>
                                        <option value="100" <%= ((!filter.q_page_size) ? '' : (filter.q_page_size == 100)) ? 'selected' : '' %>>100</option>
                                    </select>
                                </th>
                                <th width="20%">
                                    <input id="q_code" type="text" class="form-control form-control-user" name="q_code" value="<%= filter.q_code %>" autocomplete="q_code">
                                </th>
                                <th width="15%">
                                    <input id="q_desc" type="text" class="form-control form-control-user" name="q_desc" value="<%= filter.q_desc %>" autocomplete="q_desc">
                                </th>
                                <th width="10%">
                                    <select name="q_discount_percent_status" id="q_discount_percent_status"  class="form-control form-control-user" value="" autocomplete="q_discount_percent_status">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="Active" <%= ((!filter.q_discount_percent_status) ? '' : (filter.q_discount_percent_status == 'Active')) ? 'selected' : '' %>>Active</option>
                                        <option value="Inactive" <%= ((!filter.q_discount_percent_status) ? '' : (filter.q_discount_percent_status == 'Inactive')) ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </th>
                                <th>
									<div class="row">
										<div class="col" style="float: right">
											<select name="q_discount_percent_operator" id="q_discount_percent_operator"  class="form-control form-control-user" value="" autocomplete="q_discount_percent_operator">
												<option disabled="disabled" selected>..</option>
												<option value="=" <%= ((!filter.q_discount_percent_operator) ? '' : (filter.q_discount_percent_operator == '=')) ? 'selected' : '' %>>=</option>
												<option value=">" <%= ((!filter.q_discount_percent_operator) ? '' : (filter.q_discount_percent_operator == '>')) ? 'selected' : '' %>></option>
												<option value=">=" <%= ((!filter.q_discount_percent_operator) ? '' : (filter.q_discount_percent_operator == '>=')) ? 'selected' : '' %>>=</option>
												<option value="<" <%= ((!filter.q_discount_percent_operator) ? '' : (filter.q_discount_percent_operator == '<Active')) ? 'selected' : '' %>><</option>
												<option value="<=" <%= ((!filter.q_discount_percent_operator) ? '' : (filter.q_discount_percent_operator == '<=')) ? 'selected' : '' %>><=</option>
											</select>
										</div>
										<div class="col" style="float: left">
											<input id="q_discount_percent" type="number" class="form-control form-control-user" name="q_discount_percent" value="<%= filter.q_discount_percent %>" autocomplete="q_discount_percent">
										</div>
									</div>
								</th>
                                <th width="10%">
                                    <select name="q_discount_amount_status" id="q_discount_amount_status"  class="form-control form-control-user" value="" autocomplete="q_discount_amount_status">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="Active" <%= ((!filter.q_discount_amount_status) ? '' : (filter.q_discount_amount_status == 'Active')) ? 'selected' : '' %>>Active</option>
                                        <option value="Inactive" <%= ((!filter.q_discount_amount_status) ? '' : (filter.q_discount_amount_status == 'Inactive')) ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </th>
                                <th>
									<div class="row">
										<div class="col" style="float: right">
											<select name="q_discount_amount_operator" id="q_discount_amount_operator"  class="form-control form-control-user" value="" autocomplete="q_discount_amount_operator">
												<option disabled="disabled" selected>..</option>
												<option value="=" <%= ((!filter.q_discount_amount_operator) ? '' : (filter.q_discount_amount_operator == '=')) ? 'selected' : '' %>>=</option>
												<option value=">" <%= ((!filter.q_discount_amount_operator) ? '' : (filter.q_discount_amount_operator == '>')) ? 'selected' : '' %>></option>
												<option value=">=" <%= ((!filter.q_discount_amount_operator) ? '' : (filter.q_discount_amount_operator == '>=')) ? 'selected' : '' %>>=</option>
												<option value="<" <%= ((!filter.q_discount_amount_operator) ? '' : (filter.q_discount_amount_operator == '<Active')) ? 'selected' : '' %>><</option>
												<option value="<=" <%= ((!filter.q_discount_amount_operator) ? '' : (filter.q_discount_amount_operator == '<=')) ? 'selected' : '' %>><=</option>
											</select>
										</div>
										<div class="col" style="float: left">
											<input id="q_discount_amount" type="number" class="form-control form-control-user" name="q_discount_amount" value="<%= filter.q_discount_amount %>" autocomplete="q_discount_amount">
										</div>
									</div>
								</th>
                                <th width="10%">
                                    <select name="q_type" id="q_type"  class="form-control form-control-user" value="" autocomplete="q_type">
                                        <option disabled="disabled" selected="selected">Select</option>                                        
                                        <option value="Unlimited" <%= ((!filter.q_type) ? '' : (filter.q_type == 'Unlimited')) ? 'selected' : '' %>>Unlimited</option>
                                        <option value="Limited" <%= ((!filter.q_type) ? '' : (filter.q_type == 'Limited')) ? 'selected' : '' %>>Limited</option>
                                    </select>
                                </th>
                                <th width="10%">
									<div class="row">
										<div class="col">
										    <input id="q_period_start_start" type="date" class="form-control form-control-user" name="q_period_start_start" value="<%= filter.q_period_start_start %>" autocomplete="q_period_start_start">
										</div>
										<div class="col">
										    <input id="q_period_start_end" type="date" class="form-control form-control-user" name="q_period_start_end" value="<%= filter.q_period_start_end %>" autocomplete="q_period_start_end">
										</div>
									</div>
								</th>
                                <th width="10%">
									<div class="row">
										<div class="col">
										    <input id="q_period_end_start" type="date" class="form-control form-control-user" name="q_period_end_start" value="<%= filter.q_period_end_start %>" autocomplete="q_period_end_start">
										</div>
										<div class="col">
										    <input id="q_period_end_end" type="date" class="form-control form-control-user" name="q_period_end_end" value="<%= filter.q_period_end_end %>" autocomplete="q_period_end_end">
										</div>
									</div>
								</th>
                                <th>
									<div class="row">
										<div class="col" style="float: right">
											<select name="q_number_operator" id="q_number_operator"  class="form-control form-control-user" value="" autocomplete="q_number_operator">
												<option disabled="disabled" selected>..</option>
												<option value="=" <%= ((!filter.q_number_operator) ? '' : (filter.q_number_operator == '=')) ? 'selected' : '' %>>=</option>
												<option value=">" <%= ((!filter.q_number_operator) ? '' : (filter.q_number_operator == '>')) ? 'selected' : '' %>></option>
												<option value=">=" <%= ((!filter.q_number_operator) ? '' : (filter.q_number_operator == '>=')) ? 'selected' : '' %>>=</option>
												<option value="<" <%= ((!filter.q_number_operator) ? '' : (filter.q_number_operator == '<Active')) ? 'selected' : '' %>><</option>
												<option value="<=" <%= ((!filter.q_number_operator) ? '' : (filter.q_number_operator == '<=')) ? 'selected' : '' %>><=</option>
											</select>
										</div>
										<div class="col" style="float: left">
											<input id="q_number" type="number" class="form-control form-control-user" name="q_number" value="<%= filter.q_number %>" autocomplete="q_number">
										</div>
									</div>
								</th>
                                <th width="5%" class="text-center align-middle">
                                    <div class="btn-group nospiner" >
                                        <button type="submit" form="searchform" class="btn btn-sm btn-success">
                                            <i class="fas fa-fw fa-search"></i>
                                        </button>
                                        <a  href="/admin/v1/promotion"  class="btn btn-sm btn-danger">
                                            <i class="fas fa-fw fa-times"></i>                                            
                                        </a>
                                    </div>                                      
                                </th>
                            </tr>                              
                            <tr>
                                <th width="5%"><input type="checkbox" id="checkall"/></th>
                                <th width="5%">No</th>
                                <th width="20%">Code</th>
                                <th width="20%">Desc</th>
                                <th width="10%">Discount Percent Status</th>
                                <th width="10%">Discount Percent</th>
                                <th width="10%">Discount Amount Status</th>
                                <th width="10%">Discount Amount</th>
                                <th width="10%">Type</th>
                                <th width="10%">Period Start</th>
                                <th width="10%">Period End</th>
                                <th width="10%">Number</th>
                                <th width="5%">Action</th>
                            </tr>
                        </form>
                    </thead>
                    <tbody>
                        <form id="selection">
                            <% datas.forEach((data,i) => { %>
                            <tr>
                                <td><input name="selected[]" value="<%= data.id %>" type="checkbox" /></td>
                                <td><%= (i+1)+(paginate_data.page_size*(paginate_data.current_page-1)) %></td>
                                <td><%= data.code %></td>
                                <td><%= data.desc %></td>
                                <td><center><img src="<%= (data.discount_percent_status == 'Active') ? getFile('modules/access/true.png') : getFile('modules/access/false.png') %>" width="30px" height="30px"></center></td>
                                <td><%= data.discount_percent %></td>
                                <td><center><img src="<%= (data.discount_amount_status == 'Active') ? getFile('modules/access/true.png') : getFile('modules/access/false.png') %>" width="30px" height="30px"></center></td>
                                <td><%= data.discount_amount %></td>
                                <td><%= data.period_type %></td>
                                <td><%= formatDate(data.period_start,true) %></td>
                                <td><%= formatDate(data.period_end,true) %></td>
                                <td><%= data.number %></td>
                                <td align="center">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            Action
                                        </button>
                                        <div class="dropdown-menu">
                                            <a href="/admin/v1/promotion/<%= data.id %>/institution" class="dropdown-item">Institution</a>
                                            <a href="/admin/v1/promotion/<%= data.id %>/edit" class="dropdown-item">Edit</a>
                                            <a href="/admin/v1/promotion/<%= data.id %>/delete" onclick="return confirm('Confirm Delete')" class="dropdown-item">Delete</a>                                              
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </form>
                    </tbody>
                </table>
                <div class="d-flex justify-content-center">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">
                            <% if(paginate_data.current_page != 1) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page-1) %>">Previous</a></li>
                            <% } %>
                            <% for(let index = 1; index <= paginate_data.total_page; index++) { %>
                            <li class="page-item <%= (index==paginate_data.current_page)?'active':'' %>"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', index) %>"><%= index %></a></li>
                            <% } %>
                            <% if(paginate_data.current_page != paginate_data.total_page && paginate_data.total_page!=0) { %>
                            <li class="page-item"><a class="page-link" href="<%= addOrUpdateQueryParam(fullUrl, 'q_page', paginate_data.current_page+1) %>">Next</a></li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>                
    </div>
</div>
<script>
    $("#checkall").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
    });        
</script>