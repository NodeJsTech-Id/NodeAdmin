<!-- Rich text editor untuk elemen .trumbowyg -->
<script>
    if (window.jQuery && jQuery.fn.trumbowyg) { $(".trumbowyg").trumbowyg(); }
</script>

<!-- Toggle sidebar (mobile) -->
<script>
    (function () {
        var sb = document.getElementById('tw-sidebar');
        var ov = document.getElementById('tw-sidebar-overlay');
        var btn = document.getElementById('tw-sidebar-toggle');
        function open() { sb.classList.remove('-translate-x-full'); ov.classList.remove('hidden'); }
        function close() { sb.classList.add('-translate-x-full'); ov.classList.add('hidden'); }
        if (btn) btn.addEventListener('click', open);
        if (ov) ov.addEventListener('click', close);
    })();
</script>

<!-- Inject token CSRF ke semua form (kecuali GET) secara otomatis -->
<script>
    (function () {
        var meta = document.querySelector('meta[name="csrf-token"]');
        if (!meta) return;
        var token = meta.getAttribute('content');
        document.querySelectorAll('form').forEach(function (f) {
            var method = (f.getAttribute('method') || 'get').toLowerCase();
            if (method === 'get') return;
            var enctype = (f.getAttribute('enctype') || '').toLowerCase();
            if (enctype.indexOf('multipart') !== -1) {
                // Form multipart: body baru diparse multer SETELAH csrf middleware,
                // jadi hidden field _csrf tak terbaca. Taruh token di query action.
                var action = f.getAttribute('action') || '';
                if (action.indexOf('_csrf=') === -1) {
                    action += (action.indexOf('?') !== -1 ? '&' : '?') + '_csrf=' + encodeURIComponent(token);
                    f.setAttribute('action', action);
                }
                return;
            }
            if (f.querySelector('input[name="_csrf"]')) return;
            var input = document.createElement('input');
            input.type = 'hidden'; input.name = '_csrf'; input.value = token;
            f.appendChild(input);
        });
    })();
</script>

<!-- Fallback gambar gagal load → placeholder ikon Font Awesome sesuai konteks -->
<script>
    (function () {
        function placeholder(img) {
            if (img.dataset.imgFallback) return; // cegah loop
            img.dataset.imgFallback = '1';

            // Tentukan ikon berdasarkan konteks (avatar/foto vs logo/gambar umum)
            var cls = (img.className || '') + ' ' + (img.getAttribute('alt') || '');
            var isAvatar = /rounded-full|rounded-circle|img-profile|picture|avatar|user/i.test(cls);
            var icon = isAvatar ? 'fa-user' : 'fa-image';

            // Ukuran placeholder mengikuti dimensi gambar bila ada
            var w = img.getAttribute('width') || img.offsetWidth || 40;
            var h = img.getAttribute('height') || img.offsetHeight || 40;
            var box = document.createElement('span');
            box.className = 'img-placeholder ' + (img.className || '');
            box.style.cssText = 'display:inline-flex;align-items:center;justify-content:center;' +
                'width:' + w + 'px;height:' + h + 'px;background:#f1f5f9;color:#94a3b8;' +
                (isAvatar ? 'border-radius:9999px;' : 'border-radius:.5rem;');
            box.innerHTML = '<i class="fas ' + icon + '" style="font-size:' + Math.max(14, Math.min(w, h) * 0.45) + 'px"></i>';
            if (img.parentNode) img.parentNode.replaceChild(box, img);
        }
        // Tangkap error load gambar di fase capture (event 'error' tidak bubbling)
        document.addEventListener('error', function (e) {
            var t = e.target;
            if (t && t.tagName === 'IMG') placeholder(t);
        }, true);
        // Gambar yang sudah gagal sebelum handler terpasang
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('img').forEach(function (img) {
                if (img.complete && img.naturalWidth === 0) placeholder(img);
            });
        });
    })();
</script>

<!-- Dropdown (vanilla, pengganti Bootstrap JS) -->
<script>
    (function () {
        // Toggle saat klik elemen ber-atribut [data-toggle-dd]
        document.addEventListener('click', function (e) {
            var trigger = e.target.closest('[data-toggle-dd]');
            var box = trigger ? trigger.closest('.dropdown, .btn-group') : null;
            var current = box ? box.querySelector('.dropdown-menu') : null;
            // Tutup semua menu yang terbuka kecuali yang sedang diklik
            document.querySelectorAll('.dropdown-menu.show').forEach(function (m) {
                if (m !== current) m.classList.remove('show');
            });
            if (current) {
                e.preventDefault();
                current.classList.toggle('show');
            }
        });
    })();
</script>
