APP_PORT=3000
APP_HOST="http://localhost"
APP_NAME="Node Admin"
NODE_ENV=development

# Supported DB_TYPE: mysql | mariadb | postgres | cockroachdb | sqlite | better-sqlite3 | mssql | oracle
# - SQLite: isi DB_DATABASE dengan path file (mis. ./database.sqlite); host/port/user/pass diabaikan.
# - Install driver sesuai DB_TYPE: mysql2 (mysql/mariadb), pg (postgres/cockroachdb),
#   sqlite3/better-sqlite3, mssql, oracledb. Default terpasang: mysql2 + pg.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nodeadmin
DB_SYNCHRONIZE=false
DB_LOGGING=true

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURE=false

REDIS_URL="redis://127.0.0.1:6379"

# Alibaba Cloud OSS (penyimpanan file). Semua wajib diisi — client OSS dibuat
# saat startup, app gagal start bila ACCESS_ID/ACCESS_KEY kosong.
OSS_ACCESS_ID=
OSS_ACCESS_KEY=
OSS_ENDPOINT=oss-ap-southeast-5.aliyuncs.com
OSS_BUCKET=
OSS_SSL=true

# WAJIB diisi di production (app gagal start bila kosong saat NODE_ENV=production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Keamanan & performa (opsional — ada default)
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=10
SESSION_TTL_HOURS=6
DB_CONNECTION_LIMIT=10
DEFAULT_PAGE_SIZE=10